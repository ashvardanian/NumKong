@PACKAGE_INIT@

# The libraries link the runtimes of the GPU units they carry.
include(CMakeFindDependencyMacro)
if (NOT "@NUMKONG_CUDA_ARCH@" STREQUAL "")
    find_dependency(CUDAToolkit)
    set(numkong_cuda_FOUND TRUE)
endif ()
if (NOT "@NUMKONG_ROCM_ARCH@" STREQUAL "")
    find_dependency(hip)
    set(numkong_rocm_FOUND TRUE)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/numkongTargets.cmake")

# The export defines `numkong::abi`, `numkong::cpp`, `numkong::header`, `numkong::static`, and `numkong::shared`. Flavors
# and GPU vendors are components, so `COMPONENTS shared cuda` fails at configure time where either is absent.
foreach (numkong_flavor_ abi cpp header static shared)
    if (TARGET numkong::${numkong_flavor_})
        set(numkong_${numkong_flavor_}_FOUND TRUE)
    endif ()
endforeach ()
unset(numkong_flavor_)

check_required_components(numkong)
