@PACKAGE_INIT@

# The libraries link the runtimes of the GPU units they carry.
include(CMakeFindDependencyMacro)
if (NOT "@NUMKONG_CUDA_ARCH@" STREQUAL "")
    find_dependency(CUDAToolkit)
    set(numkong_cuda_FOUND TRUE)
endif ()
if (NOT "@NUMKONG_ROCM_ARCH@" STREQUAL "")
    find_dependency(hip)
    set(numkong_rocm_FOUND TRUE)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/numkongTargets.cmake")

# Flavors and GPU vendors as components, so `COMPONENTS shared cuda` fails at configure time where either is absent.
set(numkong_header_FOUND TRUE)
set(numkong_static_FOUND TRUE)
if (TARGET numkong::shared)
    set(numkong_shared_FOUND TRUE)
endif ()

check_required_components(numkong)
