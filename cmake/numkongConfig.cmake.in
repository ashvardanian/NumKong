@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/numkongTargets.cmake")

# The export defines `numkong::numkong` (header-only) and, when the dynamic library was built,
# `numkong::shared`. Add the plain spellings too, so a consumer can write either:
# ~~~
# target_link_libraries(my_executable PRIVATE numkong)
# target_link_libraries(my_executable PRIVATE numkong::numkong)
# ~~~
# `add_subdirectory` consumers get the mirror image from the `ALIAS` targets in `CMakeLists.txt`.
#
# Aliasing a non-GLOBAL imported target - which is what `install(EXPORT)` writes - is only legal from
# CMake 3.18, and this file runs under the *consumer's* CMake, not ours. Below that, the namespaced
# spelling still works; only this convenience is skipped, which beats failing the `find_package`.
if (NOT CMAKE_VERSION VERSION_LESS 3.18)
    if (NOT TARGET numkong)
        add_library(numkong ALIAS numkong::numkong)
    endif ()
    if (TARGET numkong::shared AND NOT TARGET nk_shared)
        add_library(nk_shared ALIAS numkong::shared)
    endif ()
endif ()

set(numkong_VERSION @PACKAGE_VERSION@)
