#!/usr/bin/env bash
# NumKong pre-commit: enforce the house style on staged changes before they land.
#
# The Doxygen / string-literal checks run on .c/.h/.hpp/.cpp, the decorative-ruler and formatter-off bans
# run on every staged file, and the formatter gates (cmake-format / clang-format / rustfmt / ruff /
# swift-format) keep the checked-in profiles the law. Each check inspects only the ADDED lines of a staged
# file, so legacy code migrates on its own schedule while no new violation sneaks in, and each prints the
# specific reason when it fires.
#
# The checks are scoped to C: this codebase has no C++/CUDA constructs, so there is nothing here for
# namespace, include-group-order, STL-container, or kernel-launch rules to police.
#
# Bypass knowingly (you almost never should) with: git commit --no-verify

set -u

failed=0

# Per C source: Doxygen and string-literal conventions on the added lines only.
while IFS= read -r file; do
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc) ;;
    *) continue ;;
    esac
    added_lines=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++')

    # Every @param declares its direction — [in]/[out]/[inout] — so a reader knows whether the callee
    # reads, writes, or mutates the argument. A bare @param and the comma form @param[in,out] are both
    # rejected; the one spelling for a mutated argument is @param[inout].
    param_direction=$(printf '%s\n' "$added_lines" | grep -nE '@param' |
        grep -vE '@param\[(in|out|inout)\]' || true)
    if [ -n "$param_direction" ]; then
        echo "pre-commit: $file has a @param without an [in]/[out]/[inout] direction — never a bare"
        echo "            @param nor the comma form @param[in,out] (write @param[inout]):"
        printf '%s\n' "$param_direction" | head -5
        failed=1
    fi

    # A split string literal whose fragment lacks the trailing `//` pin gets restitched by clang-format
    # into unreadable staircases; every fragment except the last must end with `" //`.
    unpinned_splits=$(printf '%s\n' "$added_lines" | awk '
        prev ~ /"[[:space:]]*$/ && prev !~ /\/\/[[:space:]]*$/ && $0 ~ /^\+[[:space:]]*"/ { print NR": "prev }
        { prev = $0 }' || true)
    if [ -n "$unpinned_splits" ]; then
        echo "pre-commit: $file splits a string literal without the trailing \`//\` pin — clang-format"
        echo "            will restitch the fragments into a staircase; pin every fragment but the last:"
        printf '%s\n' "$unpinned_splits" | head -5
        failed=1
    fi

    # Doxygen renders @b / @c, not Markdown: `__bold__` / `**bold**` in a `/** */` or `//` comment print
    # literally. Use @b for a one/two-token emphasis and plain prose for anything longer. C `__keyword__`
    # spellings are exempt.
    markdown_doxygen=$(printf '%s\n' "$added_lines" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -oE '\*\*[^*]+\*\*|__[^_]+__' |
        grep -vE '^__(restrict|inline|volatile|asm|attribute|builtin[A-Za-z0-9_]*|STDC)__$' || true)
    if [ -n "$markdown_doxygen" ]; then
        echo "pre-commit: $file uses Markdown emphasis in a Doxygen comment (it prints literally) — use @b"
        echo "            for a 1-2 token emphasis, plain prose otherwise:"
        printf '%s\n' "$markdown_doxygen" | head -5
        failed=1
    fi

    # Member documentation is Doxygen: a bare `//` line directly above a declaration (a member or a type)
    # is the banned doc style — those entities get `/** @brief ... */`. Scoped to headers on purpose: the
    # same `Type name = ...;` shape inside a `.c` function body is a local variable, and a `//` note above
    # it is a legal implementation note. The `\+?` prefix matches the `+` git diff prepends to added lines.
    case "$file" in
    *.h | *.hpp)
        member_doc_comments=$(printf '%s\n' "$added_lines" |
            awk '/^\+?[[:space:]]*\/\/[^\/]/ { pending=$0; next } \
                 /^\+?[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,* ]* [A-Za-z_][A-Za-z0-9_]* *([={;]|$)/ && pending { print pending; pending="" ; next } \
                 { pending="" }' || true)
        if [ -n "$member_doc_comments" ]; then
            echo "pre-commit: $file documents a declaration with a bare \`//\` comment — docs are"
            echo "            /** @brief ... */ blocks; \`//\` is for implementation notes inside bodies:"
            printf '%s\n' "$member_doc_comments" | head -5
            failed=1
        fi
        ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM)

# CMake — CMakeLists.txt / *.cmake must satisfy the checked-in .cmake-format.py profile (whole-file, the
# way cmake-format works). This is the gate that catches accidental whole-file reformats.
if command -v cmake-format > /dev/null 2>&1; then
    while IFS= read -r file; do
        case "$file" in
        CMakeLists.txt | *.cmake) ;;
        *) continue ;;
        esac
        if ! cmake-format --check "$file" > /dev/null 2>&1; then
            echo "pre-commit: $file is not cmake-format clean — run: cmake-format -i $file"
            failed=1
        fi
    done < <(git diff --cached --name-only --diff-filter=ACM)
fi

# C/C++ — changed lines must satisfy .clang-format. `git clang-format --staged --diff` restricts to the
# staged hunks, so existing `clang-format off` regions and legacy formatting are untouched.
if command -v git-clang-format > /dev/null 2>&1 && command -v clang-format > /dev/null 2>&1; then
    cpp_staged=$(git diff --cached --name-only --diff-filter=ACM -- \
        '*.c' '*.h' '*.cc' '*.cpp' '*.hpp' '*.cu' '*.cuh')
    if [ -n "$cpp_staged" ]; then
        clang_diff=$(git clang-format --staged --diff -- $cpp_staged 2> /dev/null)
        case "$clang_diff" in
        "" | "no modified files to format" | "clang-format did not modify any files"*) ;;
        *)
            echo "pre-commit: staged C/C++ changes are not clang-format clean on their changed lines — restage after:"
            echo "            git clang-format --staged   (or clang-format -i <file> for the whole file)"
            failed=1
            ;;
        esac
    fi
fi

# Rust — the crate must stay rustfmt-clean (respects rustfmt.toml). Whole-file check; skips without cargo.
if command -v cargo > /dev/null 2>&1; then
    if git diff --cached --name-only --diff-filter=ACM -- '*.rs' | grep -q .; then
        if ! cargo fmt --check > /dev/null 2>&1; then
            echo "pre-commit: staged Rust changes are not rustfmt clean — run: cargo fmt"
            failed=1
        fi
    fi
fi

# Rust — `macro_rules!` is banned: every per-type impl is written out explicitly (see rust/cast.rs). Added
# lines only, so a pre-existing macro migrates on its own schedule while no new one lands.
while IFS= read -r file; do
    case "$file" in
    *.rs) ;;
    *) continue ;;
    esac
    macro_hits=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++' |
        grep -nE 'macro_rules!' || true)
    if [ -n "$macro_hits" ]; then
        echo "pre-commit: $file adds a \`macro_rules!\` — banned; write each impl out explicitly:"
        printf '%s\n' "$macro_hits" | head -5
        failed=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# ISA kernels — every SIMD register variable must encode its element type and width. The naming grammar
# is per-ISA: `<role>_<dtype>x<lanes>` for fixed-width lanes (x86 / NEON / WASM / Loongson / Power),
# `<role>_<dtype>x` for scalable SVE/SME, `<role>_<dtype>m<lmul>` for RISC-V RVV; masks/predicates are
# `mask`/`<role>_mask` or `<role>_b<n>x<lanes>` (x86), `<role>_b<n>x` (SVE), `<role>_b<n>` (RVV). Scoped to
# ISA-specific files only
# — never serial.h, the umbrella <family>.h, or any .hpp. Added lines only; a line carrying an inline
# `// nk-nolint: naming` comment is grandfathered. Tile-typed locals (`*_tile`/`state`) and `*_vec`/`*_tail`
# reinterpret-staging unions are exempt. Function signatures are skipped (the name is followed by `(`).
while IFS= read -r file; do
    base="${file##*/}"
    case "$base" in
    haswell.h | skylake.h | icelake.h | genoa.h | sapphire.h | sapphireamx.h | graniteamx.h | alder.h | \
        sierra.h | turin.h | v128relaxed.h | loongsonasx.h | powervsx.h | neon*.h) isa="fixed" ;;
    sve*.h | sme*.h) isa="sve" ;;
    rvv*.h) isa="rvv" ;;
    *) continue ;;
    esac
    # Only ISA files that live under include/numkong/<family>/ — not a stray same-named file elsewhere.
    case "$file" in
    */numkong/*/"$base") ;;
    *) continue ;;
    esac
    bad_names=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++' |
        grep -v 'nk-nolint: naming' |
        awk -v isa="$isa" '
        function ok_vec(name) {
            if (isa == "fixed") return name ~ /_(f16|f32|f64|bf16|e2m3|e3m2|e4m3|e5m2|i8|i16|i32|i64|u8|u16|u32|u64)x[0-9]+(x[234])?$/ || name ~ /_b(8|16|32|64)x[0-9]+$/
            if (isa == "sve")   return name ~ /_(f16|f32|f64|bf16|i8|i16|i32|i64|u8|u16|u32|u64)x$/
            if (isa == "rvv")   return name ~ /_(f16|f32|f64|bf16|i8|i16|i32|i64|u8|u16|u32|u64)m[1248](x[234])?$/
        }
        function ok_mask(name) {
            if (isa == "fixed") return name == "mask" || name ~ /_mask$/ || name ~ /_b(8|16|32|64)x[0-9]+$/
            if (isa == "sve")   return name ~ /_b(8|16|32|64)x$/
            if (isa == "rvv")   return name ~ /_b(1|2|4|8|16|32|64)$/
        }
        function exempt(name) { return name ~ /(_vec|_tail|_tile)$/ || name == "state" }
        {
            line = $0; sub(/^\+/, "", line); sub(/\/\/.*/, "", line)
            n = split(line, tok, /[[:space:]]+/)
            for (i = 1; i <= n; i++) {
                t = tok[i]
                is_mask = (t ~ /^(__mmask[0-9]+|svbool_t|vbool[0-9]+_t)$/)
                is_vec  = (t ~ /^(__m(128|256|512)[id]?|__m512bh|v128_t|(float|int|uint|bfloat|poly)[0-9]+x[0-9]+(x[234])?_t|sv(float|int|uint|bfloat)[0-9]*_t|v(float|int|uint|bfloat)[0-9]+m[1248](x[234])?_t|nk_v[a-z0-9]+_t)$/)
                if (!is_mask && !is_vec) continue
                name = tok[i+1]
                if (name == "const") name = tok[i+2]
                if (name ~ /\(/) break                 # function signature — skip the whole line
                sub(/[=;,].*/, "", name)               # strip trailing punctuation / initializer
                if (name == "" || name ~ /[^A-Za-z0-9_]/) continue
                if (exempt(name)) break
                if (is_mask ? ok_mask(name) : ok_vec(name)) break
                print "    " t " " name
                break
            }
        }' || true)
    if [ -n "$bad_names" ]; then
        echo "pre-commit: $file has a SIMD register whose name breaks the $isa naming convention"
        echo "            (<role>_<dtype>x<lanes> / _<dtype>x / _<dtype>m<lmul>; masks per ISA). Rename, or"
        echo "            grandfather one line with a trailing \`// nk-nolint: naming\`:"
        printf '%s\n' "$bad_names" | head -5
        failed=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# Python — ruff format + lint on the staged files, plus the ALL-CAPS-emphasis ban on changed lines. Ruff
# is tool-guarded (a missing ruff skips rather than blocks); the emphasis grep is pure shell and runs
# whenever a `.py` file is staged.
if command -v ruff > /dev/null 2>&1; then
    py_staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
    if [ -n "$py_staged" ]; then
        if ! ruff format --check --quiet --force-exclude $py_staged > /dev/null 2>&1; then
            echo "pre-commit: staged Python changes are not ruff-format clean — run: ruff format <files>"
            failed=1
        fi
        if ! ruff check --quiet --force-exclude $py_staged > /dev/null 2>&1; then
            echo "pre-commit: staged Python changes have ruff lint findings — run: ruff check --fix <files>"
            failed=1
        fi
    fi
fi
while IFS= read -r file; do
    added_lines=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++')
    # No ALL-CAPS-for-emphasis in docstrings / comments (protocol / token names excepted).
    emphasis=$(printf '%s\n' "$added_lines" |
        grep -nE '\b(ONLY|NEVER|ALWAYS|EVERY|WHOLE)\b' || true)
    if [ -n "$emphasis" ]; then
        echo "pre-commit: $file uses ALL-CAPS emphasis on a changed line — lowercase it:"
        printf '%s\n' "$emphasis" | head -5
        failed=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.py')

# Swift — swift-format lint against the checked-in .swift-format. Skips without swift-format.
if command -v swift-format > /dev/null 2>&1; then
    swift_staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.swift')
    if [ -n "$swift_staged" ]; then
        if ! swift-format lint --strict $swift_staged > /dev/null 2>&1; then
            echo "pre-commit: staged Swift changes are not swift-format clean — run: swift-format -i <files>"
            failed=1
        fi
    fi
fi

# Project-wide, every staged file: no decorative banner rulers and no formatter-disabling directives.
# A staged line that is only dashes, equals, slashes, or hashes (a `# -----` / `// =====` / `//////` /
# `#####` ruler) is banned everywhere except Markdown, where a run of dashes is legal (horizontal rules,
# table separators) and `###` opens a heading. Turning a formatter off in-band is banned too — the
# checked-in .clang-format / .cmake-format.py profiles are the law, so a file must format clean as a
# whole rather than fencing regions the tool is told to skip. Patterns are line-anchored so prose that
# merely names a directive does not trip the check.
while IFS= read -r file; do
    added=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++')
    case "$file" in
    *.md | *.markdown) ;;
    *)
        rulers=$(printf '%s\n' "$added" |
            grep -nE '^\+[[:space:]]*(([#]+|//)?[[:space:]]*[-=]{3,}|/{4,}|#{3,})[[:space:]]*$' || true)
        if [ -n "$rulers" ]; then
            echo "pre-commit: $file adds a decorative banner ruler (---/===////+/###; banned outside Markdown):"
            printf '%s\n' "$rulers" | head -5
            failed=1
        fi
        ;;
    esac
    format_off=$(printf '%s\n' "$added" |
        grep -nE '^\+[[:space:]]*(//[[:space:]]*clang-format[[:space:]]+(on|off)|#[[:space:]]*cmake-format:[[:space:]]*(on|off))[[:space:]]*$' || true)
    if [ -n "$format_off" ]; then
        echo "pre-commit: $file disables a formatter in-band — the .clang-format / .cmake-format.py profile is the law,"
        echo "            teach the tool (additional_commands / config) instead of fencing a region off:"
        printf '%s\n' "$format_off" | head -5
        failed=1
    fi

    # Prose uses a single space between sentences: a period/question/exclamation followed by two-plus
    # spaces and a capital is the double-space habit. Added lines only; a line carrying an inline
    # `nk-nolint: spacing` comment is skipped (e.g. a deliberately column-aligned table).
    double_space=$(printf '%s\n' "$added" | grep -v 'nk-nolint: spacing' |
        grep -nE '[.!?]  +[A-Z]' || true)
    if [ -n "$double_space" ]; then
        echo "pre-commit: $file double-spaces between sentences — use a single space after . ! ?:"
        printf '%s\n' "$double_space" | head -5
        failed=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$failed" -ne 0 ]; then
    echo ""
    echo "Staged changes violate the house style (see the reasons above). Fix and re-stage, or bypass"
    echo "knowingly with: git commit --no-verify"
    exit 1
fi
exit 0
